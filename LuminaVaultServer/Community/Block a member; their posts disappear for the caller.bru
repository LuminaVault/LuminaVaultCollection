meta {
  name: Block a member; their posts disappear for the caller
  type: http
  seq: 12
  tags: [
    Community
  ]
}

post {
  url: {{baseUrl}}/v1/community/blocks
  body: json
  auth: inherit
}

body:json {
  {
    "profileId": ""
  }
}

example {
  name: 204 Response
  description: Blocked.

  request: {
    url: {{baseUrl}}/v1/community/blocks
    method: POST
    mode: json
    body:json: {
      {
        "profileId": ""
      }
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

