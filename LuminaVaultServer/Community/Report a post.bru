meta {
  name: Report a post
  type: http
  seq: 9
  tags: [
    Community
  ]
}

post {
  url: {{baseUrl}}/v1/community/posts/:postID/report
  body: json
  auth: inherit
}

params:path {
  postID:
}

body:json {
  {
    "reason": "spam",
    "note": ""
  }
}

docs {
  One report per member per post; a repeat is a no-op. The third distinct open report hides the post until a moderator decides.
}

example {
  name: 202 Response
  description: Report filed.

  request: {
    url: {{baseUrl}}/v1/community/posts/:postID/report
    method: POST
    mode: json
    params:path: {
      postID:
    }

    body:json: {
      {
        "reason": "spam",
        "note": ""
      }
    }
  }

  response: {
    status: {
      code: 202
      text: Accepted
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 400 Response
  description: `cannot_report_own_post`.

  request: {
    url: {{baseUrl}}/v1/community/posts/:postID/report
    method: POST
    mode: json
    params:path: {
      postID:
    }

    body:json: {
      {
        "reason": "spam",
        "note": ""
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 404 Response
  description: `post_not_found`.

  request: {
    url: {{baseUrl}}/v1/community/posts/:postID/report
    method: POST
    mode: json
    params:path: {
      postID:
    }

    body:json: {
      {
        "reason": "spam",
        "note": ""
      }
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
