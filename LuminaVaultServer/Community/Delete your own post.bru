meta {
  name: Delete your own post
  type: http
  seq: 6
  tags: [
    Community
  ]
}

delete {
  url: {{baseUrl}}/v1/community/posts/:postID
  body: none
  auth: inherit
}

params:path {
  postID:
}

example {
  name: 204 Response
  description: Deleted.

  request: {
    url: {{baseUrl}}/v1/community/posts/:postID
    method: DELETE
    mode: none
    params:path: {
      postID:
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 404 Response
  description: `post_not_found`.

  request: {
    url: {{baseUrl}}/v1/community/posts/:postID
    method: DELETE
    mode: none
    params:path: {
      postID:
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
