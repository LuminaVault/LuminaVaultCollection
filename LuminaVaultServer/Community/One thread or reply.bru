meta {
  name: One thread or reply
  type: http
  seq: 5
  tags: [
    Community
  ]
}

get {
  url: {{baseUrl}}/v1/community/posts/:postID
  body: none
  auth: inherit
}

params:path {
  postID:
}

example {
  name: 200 Response
  description: The post.

  request: {
    url: {{baseUrl}}/v1/community/posts/:postID
    method: GET
    mode: none
    params:path: {
      postID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "parentId": "",
          "title": "",
          "body": "",
          "author": {
            "kind": "user",
            "profileId": "",
            "handle": "",
            "displayName": ""
          },
          "isDailyPost": false,
          "aiLabel": "",
          "status": "pending",
          "replyCount": 0,
          "reactionCount": 0,
          "viewerReacted": false,
          "isOwn": false,
          "createdAt": "",
          "lastActivityAt": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: `post_not_found` (also for hidden posts and blocked authors).

  request: {
    url: {{baseUrl}}/v1/community/posts/:postID
    method: GET
    mode: none
    params:path: {
      postID:
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
