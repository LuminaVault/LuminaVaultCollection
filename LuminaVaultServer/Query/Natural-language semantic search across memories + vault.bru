meta {
  name: Natural-language semantic search across memories + vault
  type: http
  seq: 1
  tags: [
    Query
  ]
}

post {
  url: {{baseUrl}}/v1/query
  body: json
  auth: inherit
}

body:json {
  {
    "query": "",
    "limit": 0
  }
}

example {
  name: 200 Response
  description: Query result.

  request: {
    url: {{baseUrl}}/v1/query
    method: POST
    mode: json
    body:json: {
      {
        "query": "",
        "limit": 0
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "summary": "",
          "hits": [
            {
              "id": "",
              "content": "",
              "distance": 0,
              "createdAt": "",
              "snippet": "",
              "citation": ""
            }
          ],
          "followUps": []
        }
      '''
    }
  }
}
