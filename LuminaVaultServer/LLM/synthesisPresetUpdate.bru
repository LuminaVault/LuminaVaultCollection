  ]
}

put {
  url: {{baseUrl}}/v1/router/synthesis-presets/:presetID
  body: json
  auth: inherit
}

params:path {
  presetID:
}

body:json {
  {
    "name": "",
    "prompt": ""
  }
}

example {
  name: 200 Response
  description: Updated preset.

  request: {
    url: {{baseUrl}}/v1/router/synthesis-presets/:presetID
    method: PUT
