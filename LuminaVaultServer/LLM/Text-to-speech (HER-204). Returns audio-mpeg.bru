meta {
  name: Text-to-speech (HER-204). Returns audio/mpeg
  type: http
  seq: 22
  tags: [
    LLM
  ]
}

post {
  url: {{baseUrl}}/v1/tts
  body: json
  auth: inherit
}

body:json {
  {
    "text": "",
    "voice": "",
    "model": "",
    "format": "mp3"
  }
}

example {
  name: 200 Response
  description: MP3 audio stream.

  request: {
    url: {{baseUrl}}/v1/tts
    method: POST
    mode: json
    body:json: {
      {
        "text": "",
        "voice": "",
        "model": "",
        "format": "mp3"
      }
    }
  }

  response: {
    headers: {
      Content-Type: audio/mpeg
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
