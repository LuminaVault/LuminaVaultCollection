meta {
  name: Find the memories nearest an image (HER-205 follow-up)
  type: http
  seq: 24
  tags: [
    LLM
  ]
}

post {
  url: {{baseUrl}}/v1/vision/search
  body: none
  auth: inherit
}

params:query {
  @description('1–50, default 10. Out-of-range values are rejected rather than clamped.')
  limit: 10
}

docs {
  Embeds the image and runs its vector against `memories.embedding`,
  which `/v1/vision/embed` already documents itself as compatible with.
  No OCR step: image and memory vectors share a space by construction,
  so there is no text in the middle to mistranslate the picture.

  Raw image body, same media types and 8 MB cap as `/v1/vision/embed`.

}

example {
  name: 200 Response
  description: Nearest memories, closest first.

  request: {
    url: {{baseUrl}}/v1/vision/search
    method: POST
    mode: none
    params:query: {
      limit: 10
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "hits": [
            {
              "id": "",
              "content": "",
              "distance": 0,
              "createdAt": ""
            }
          ],
          "model": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: limit out of range.

  request: {
    url: {{baseUrl}}/v1/vision/search
    method: POST
    mode: none
    params:query: {
      limit: 10
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 413 Response
  description: Image body exceeded the 8 MB cap.

  request: {
    url: {{baseUrl}}/v1/vision/search
    method: POST
    mode: none
    params:query: {
      limit: 10
    }
  }

  response: {
    status: {
      code: 413
      text: Payload Too Large
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 415 Response
  description: Unsupported image media type.

  request: {
    url: {{baseUrl}}/v1/vision/search
    method: POST
    mode: none
    params:query: {
      limit: 10
    }
  }

  response: {
    status: {
      code: 415
      text: Unsupported Media Type
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 503 Response
  description: No vision embed provider configured.

  request: {
    url: {{baseUrl}}/v1/vision/search
    method: POST
    mode: none
    params:query: {
      limit: 10
    }
  }

  response: {
    status: {
      code: 503
      text: Service Unavailable
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
