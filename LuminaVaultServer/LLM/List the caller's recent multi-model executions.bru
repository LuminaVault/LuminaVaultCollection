meta {
  name: List the caller's recent multi-model executions
  type: http
  seq: 11
  tags: [
    LLM
  ]
}

get {
  url: {{baseUrl}}/v1/router/parallel/executions
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: Execution history.

  request: {
    url: {{baseUrl}}/v1/router/parallel/executions
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "executions": [
            {
              "id": "",
              "strategy": "auto",
              "status": "running",
              "promptPreview": "",
              "participantCount": 0,
              "estimatedCostUsdMicros": 0,
              "latencyMs": 0,
              "createdAt": ""
            }
          ]
        }
      '''
    }
  }
}
