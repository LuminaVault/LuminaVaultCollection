example {
  name: 200 Response
  description: Import filed and compiled.

  request: {
    url: {{baseUrl}}/v1/import/:id/approve
    method: POST
    mode: json
    params:path: {
      id:
    }

    body:json: {
      {
        "overrides": {}
      }
    }
  }

  response: {
    headers: {
