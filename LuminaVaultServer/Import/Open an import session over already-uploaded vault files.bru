meta {
  name: Open an import session over already-uploaded vault files
  type: http
  seq: 3
  tags: [
    Import
  ]
}

post {
  url: {{baseUrl}}/v1/import/files
  body: json
  auth: inherit
}

body:json {
  {
    "sourceType": "documents",
    "vaultFileIds": []
  }
}

docs {
  For photos / documents / EventKit-rendered notes: the client first
  uploads each via POST /v1/vault/files, then registers the returned ids
  here so they flow through categorize → approve.

}

example {
  name: 200 Response
  description: Import session created.

  request: {
    url: {{baseUrl}}/v1/import/files
    method: POST
    mode: json
    body:json: {
      {
        "sourceType": "documents",
        "vaultFileIds": []
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "sessionId": "",
          "status": "",
          "total": 0,
          "staged": 0,
          "skipped": 0
        }
      '''
    }
  }
}
