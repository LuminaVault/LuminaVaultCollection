meta {
  name: Stage a batch of URLs into the import inbox ("Feed Your Brain")
  type: http
  seq: 1
  tags: [
    Import
  ]
}

post {
  url: {{baseUrl}}/v1/import
  body: json
  auth: inherit
}

body:json {
  {
    "sourceType": "bookmarks",
    "urls": []
  }
}

docs {
  Stages each http(s) URL as a vault file in the reserved `imported`
  Space (deduped by URL), tracked under a new import session. Follow with
  POST /v1/import/{id}/categorize, then /approve.

}

example {
  name: 200 Response
  description: Import session created.

  request: {
    url: {{baseUrl}}/v1/import
    method: POST
    mode: json
    body:json: {
      {
        "sourceType": "bookmarks",
        "urls": []
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "sessionId": "",
          "status": "",
          "total": 0,
          "staged": 0,
          "skipped": 0
        }
      '''
    }
  }
}
