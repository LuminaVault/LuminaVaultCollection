  ]
}

get {
  url: {{baseUrl}}/v1/onboarding
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: Onboarding state.

  request: {
    url: {{baseUrl}}/v1/onboarding
    method: GET
    mode: none
  }

  response: {
