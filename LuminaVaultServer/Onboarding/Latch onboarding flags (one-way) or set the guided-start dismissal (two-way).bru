meta {
  name: Latch onboarding flags (one-way) or set the guided-start dismissal (two-way)
  type: http
  seq: 2
  tags: [
    Onboarding
  ]
}

patch {
  url: {{baseUrl}}/v1/onboarding
  body: json
  auth: inherit
}

body:json {
  {
    "signupCompleted": false,
    "emailVerifiedCompleted": false,
    "soulConfiguredCompleted": false,
    "firstCaptureCompleted": false,
    "firstKBCompileCompleted": false,
    "firstQueryCompleted": false,
    "brainConfiguredCompleted": false,
    "guidedStartDismissed": false
  }
}

docs {
  The seven completion flags are one-way latches: only `true` is
  accepted and `false` is rejected with 400.

  `guidedStartDismissed` is the one exception — it is two-way.
  `true` stamps `guidedStartDismissedAt`, `false` clears it back to
  null so Settings > "Show me around" can bring the card back.

  Note that clients must never PATCH `firstCaptureCompleted`,
  `firstKBCompileCompleted` or `firstQueryCompleted` for the guided
  start card: the server latches those itself as a side effect of
  the real work (upload/link capture, memory compile, chat reply).
  See `LuminaVaultShared/docs/guided-start.md`.

}

example {
  name: 200 Response
  description: Updated state.

  request: {
    url: {{baseUrl}}/v1/onboarding
    method: PATCH
    mode: json
    body:json: {
      {
        "signupCompleted": false,
        "emailVerifiedCompleted": false,
        "soulConfiguredCompleted": false,
        "firstCaptureCompleted": false,
        "firstKBCompileCompleted": false,
        "firstQueryCompleted": false,
        "brainConfiguredCompleted": false,
        "guidedStartDismissed": false
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "signupCompleted": false,
          "signupCompletedAt": "",
          "emailVerifiedCompleted": false,
          "emailVerifiedCompletedAt": "",
          "soulConfiguredCompleted": false,
          "soulConfiguredCompletedAt": "",
          "firstCaptureCompleted": false,
          "firstCaptureCompletedAt": "",
          "firstKBCompileCompleted": false,
          "firstKBCompileCompletedAt": "",
          "firstQueryCompleted": false,
          "firstQueryCompletedAt": "",
          "brainConfiguredCompleted": false,
          "brainConfiguredCompletedAt": "",
          "guidedStartDismissedAt": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Attempted to set a flag to false (latches are one-way).

  request: {
    url: {{baseUrl}}/v1/onboarding
    method: PATCH
    mode: json
    body:json: {
      {
        "signupCompleted": false,
        "emailVerifiedCompleted": false,
        "soulConfiguredCompleted": false,
        "firstCaptureCompleted": false,
        "firstKBCompileCompleted": false,
        "firstQueryCompleted": false,
        "brainConfiguredCompleted": false,
        "guidedStartDismissed": false
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
