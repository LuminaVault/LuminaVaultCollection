meta {
  name: RevenueCat server-to-server webhook (HER-184)
  type: http
  seq: 1
  tags: [
    Billing
  ]
}

post {
  url: {{baseUrl}}/v1/billing/revenuecat-webhook
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {}
}

example {
  name: 204 Response
  description: Event ingested.

  request: {
    url: {{baseUrl}}/v1/billing/revenuecat-webhook
    method: POST
    mode: json
    body:json: {
      {}
    }
  }

  response: {
