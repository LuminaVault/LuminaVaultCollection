    body: {
      type: json
      content: '''
        {
          "events": [
            {
              "id": "",
              "eventType": "",
              "valueNumeric": 0,
              "valueText": "",
              "unit": "",
              "recordedAt": "",
              "source": "",
              "metadata": {}
            }
          ],
          "limit": 0,
          "offset": 0
        }
      '''
    }
  }
}
