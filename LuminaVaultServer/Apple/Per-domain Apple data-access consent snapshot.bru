meta {
  name: Per-domain Apple data-access consent snapshot
  type: http
  seq: 1
  tags: [
    Apple
  ]
}

get {
  url: {{baseUrl}}/v1/apple/consent
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: Consent snapshot (every domain; absent = not allowed).

  request: {
    url: {{baseUrl}}/v1/apple/consent
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "consents": [
            {
              "domain": "health",
              "allowed": false,
              "allowWrites": false,
              "lastSyncAt": ""
            }
          ]
        }
      '''
    }
  }
}
