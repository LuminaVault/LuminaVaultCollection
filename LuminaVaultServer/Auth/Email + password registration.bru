meta {
  name: Email + password registration
  type: http
  seq: 1
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/v1/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "email": "",
    "username": "",
    "password": ""
  }
}

example {
  name: 200 Response
  description: Account created, session token issued.

  request: {
    url: {{baseUrl}}/v1/auth/register
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "username": "",
        "password": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "accessToken": "",
          "refreshToken": "",
          "expiresIn": 0,
          "userId": "",
          "username": "",
          "email": "",
          "vaultInitialized": false
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: Resource conflict (e.g. duplicate registration).

  request: {
    url: {{baseUrl}}/v1/auth/register
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "username": "",
        "password": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}

example {
  name: 429 Response
  description: Rate-limit exceeded; honour `Retry-After`.

  request: {
    url: {{baseUrl}}/v1/auth/register
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "username": "",
        "password": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
