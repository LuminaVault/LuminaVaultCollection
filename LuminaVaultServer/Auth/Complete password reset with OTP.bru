meta {
  name: Complete password reset with OTP
  type: http
  seq: 9
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/v1/auth/reset-password
  body: json
  auth: inherit
}

body:json {
  {
    "email": "",
    "code": "",
    "newPassword": ""
  }
}

example {
  name: 204 Response
  description: Password reset.

  request: {
    url: {{baseUrl}}/v1/auth/reset-password
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "code": "",
        "newPassword": ""
      }
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing / invalid credential.

  request: {
    url: {{baseUrl}}/v1/auth/reset-password
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "code": "",
        "newPassword": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
