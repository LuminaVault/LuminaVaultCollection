meta {
  name: Verify a TOTP / OTP second factor
  type: http
  seq: 5
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/v1/auth/mfa/verify
  body: json
  auth: inherit
}

body:json {
  {
    "challengeId": "",
    "code": ""
  }
}

example {
  name: 200 Response
  description: Session token issued after second factor.

  request: {
    url: {{baseUrl}}/v1/auth/mfa/verify
    method: POST
    mode: json
    body:json: {
      {
        "challengeId": "",
        "code": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "accessToken": "",
          "refreshToken": "",
          "expiresIn": 0,
          "userId": "",
          "username": "",
          "email": "",
          "vaultInitialized": false
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing / invalid credential.

  request: {
    url: {{baseUrl}}/v1/auth/mfa/verify
    method: POST
    mode: json
    body:json: {
      {
        "challengeId": "",
        "code": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}

example {
  name: 429 Response
  description: Rate-limit exceeded; honour `Retry-After`.

  request: {
    url: {{baseUrl}}/v1/auth/mfa/verify
    method: POST
    mode: json
    body:json: {
      {
        "challengeId": "",
        "code": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
