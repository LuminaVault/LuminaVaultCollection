meta {
  name: Revoke a WebAuthn passkey for the authenticated user
  type: http
  seq: 24
  tags: [
    Auth
  ]
}

delete {
  url: {{baseUrl}}/v1/auth/webauthn/credentials/:credentialId
  body: none
  auth: inherit
}

params:path {
  @description('Base64url credential ID.')
  credentialId:
}

example {
  name: 204 Response
  description: Credential revoked.

  request: {
    url: {{baseUrl}}/v1/auth/webauthn/credentials/:credentialId
    method: DELETE
    mode: none
    params:path: {
      credentialId:
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 404 Response
  description: Credential not found.

  request: {
    url: {{baseUrl}}/v1/auth/webauthn/credentials/:credentialId
    method: DELETE
    mode: none
    params:path: {
      credentialId:
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
