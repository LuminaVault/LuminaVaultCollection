meta {
  name: Finalise WebAuthn authentication, issue session
  type: http
  seq: 22
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/v1/auth/webauthn/authenticate/finish
  body: json
  auth: inherit
}

body:json {
  {}
}

example {
  name: 200 Response
  description: Session issued.

  request: {
    url: {{baseUrl}}/v1/auth/webauthn/authenticate/finish
    method: POST
    mode: json
    body:json: {
      {}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "accessToken": "",
          "refreshToken": "",
          "expiresIn": 0,
          "userId": "",
          "username": "",
          "email": "",
          "vaultInitialized": false
        }
      '''
    }
  }
}
