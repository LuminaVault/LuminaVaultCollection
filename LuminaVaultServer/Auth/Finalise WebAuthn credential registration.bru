meta {
  name: Finalise WebAuthn credential registration
  type: http
  seq: 20
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/v1/auth/webauthn/register/finish
  body: json
  auth: inherit
}

body:json {
  {}
}

docs {
  Authenticated. See `authWebAuthnRegisterBegin` — the credential is bound to the bearer token's user.
}

example {
  name: 200 Response
  description: Credential registered.

  request: {
    url: {{baseUrl}}/v1/auth/webauthn/register/finish
    method: POST
    mode: json
    body:json: {
      {}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "credentialID": ""
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Not authenticated.

  request: {
    url: {{baseUrl}}/v1/auth/webauthn/register/finish
    method: POST
    mode: json
    body:json: {
      {}
    }
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 403 Response
  description: Body `username` does not match the authenticated user.

  request: {
    url: {{baseUrl}}/v1/auth/webauthn/register/finish
    method: POST
    mode: json
    body:json: {
      {}
    }
  }

  response: {
    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
