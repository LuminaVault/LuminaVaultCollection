meta {
  name: Begin WebAuthn passkey registration — returns PublicKeyCredentialCreationOptions
  type: http
  seq: 19
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/v1/auth/webauthn/register/begin
  body: json
  auth: inherit
}

body:json {
  {
    "username": "",
    "displayName": ""
  }
}

docs {
  Authenticated. The credential is bound to the bearer token's user; `username` in the body is accepted for wire compatibility and must match that user, but is never used to look an account up.
}

example {
  name: 200 Response
  description: PublicKeyCredentialCreationOptions JSON.

  request: {
    url: {{baseUrl}}/v1/auth/webauthn/register/begin
    method: POST
    mode: json
    body:json: {
      {
        "username": "",
        "displayName": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {}
      '''
    }
  }
}

example {
  name: 401 Response
  description: Not authenticated.

  request: {
    url: {{baseUrl}}/v1/auth/webauthn/register/begin
    method: POST
    mode: json
    body:json: {
      {
        "username": "",
        "displayName": ""
      }
    }
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 403 Response
  description: Body `username` does not match the authenticated user.

  request: {
    url: {{baseUrl}}/v1/auth/webauthn/register/begin
    method: POST
    mode: json
    body:json: {
      {
        "username": "",
        "displayName": ""
      }
    }
  }

  response: {
    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 503 Response
  description: WebAuthn disabled (WEBAUTHN_ENABLED=false).

  request: {
    url: {{baseUrl}}/v1/auth/webauthn/register/begin
    method: POST
    mode: json
    body:json: {
      {
        "username": "",
        "displayName": ""
      }
    }
  }

  response: {
    status: {
      code: 503
      text: Service Unavailable
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
