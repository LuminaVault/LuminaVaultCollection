meta {
  name: Exchange a refresh token for a new access token
  type: http
  seq: 3
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/v1/auth/refresh
  body: json
  auth: inherit
}

body:json {
  {
    "refreshToken": ""
  }
}

example {
  name: 200 Response
  description: New access + refresh token pair.

  request: {
    url: {{baseUrl}}/v1/auth/refresh
    method: POST
    mode: json
    body:json: {
      {
        "refreshToken": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "accessToken": "",
          "refreshToken": "",
          "expiresIn": 0,
          "userId": "",
          "username": "",
          "email": "",
          "vaultInitialized": false
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing / invalid credential.

  request: {
    url: {{baseUrl}}/v1/auth/refresh
    method: POST
    mode: json
    body:json: {
      {
        "refreshToken": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
