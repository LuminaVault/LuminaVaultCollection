meta {
  name: Exchange X (Twitter) access token for a LuminaVault session
  type: http
  seq: 14
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/v1/auth/oauth/x/exchange
  body: json
  auth: inherit
}

body:json {
  {
    "accessToken": ""
  }
}

example {
  name: 200 Response
  description: Session issued.

  request: {
    url: {{baseUrl}}/v1/auth/oauth/x/exchange
    method: POST
    mode: json
    body:json: {
      {
        "accessToken": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "accessToken": "",
          "refreshToken": "",
          "expiresIn": 0,
          "userId": "",
          "username": "",
          "email": "",
          "vaultInitialized": false
        }
      '''
    }
  }
}
