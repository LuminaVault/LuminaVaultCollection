meta {
  name: Answer the tool-call approval a run is waiting on
  type: http
  seq: 5
  tags: [
    Hermes_Runs
  ]
}

post {
  url: {{baseUrl}}/v1/hermes/runs/:id/approval
  body: json
  auth: inherit
}

params:path {
  id:
}

body:json {
  {
    "choice": "once"
  }
}

docs {
  Forwards the choice to `POST /v1/runs/{hermesRunID}/approval` and
  clears the pending approval. `409 hermes_approval_not_pending` when
  nothing is waiting (including when the approval was already answered
  on another surface).

}

example {
  name: 200 Response
  description: Choice accepted; the run resumes.

  request: {
    url: {{baseUrl}}/v1/hermes/runs/:id/approval
    method: POST
    mode: json
    params:path: {
      id:
    }

    body:json: {
      {
        "choice": "once"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "hermesRunID": "",
          "status": "queued",
          "prompt": "",
          "sessionID": "",
          "model": "",
          "conversationID": "",
          "startedAt": "",
          "finishedAt": "",
          "lastEvent": "",
          "lastSeq": 0,
          "pendingApproval": "",
          "summary": "",
          "error": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
