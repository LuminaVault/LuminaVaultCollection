      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: No approval pending (`hermes_approval_not_pending`).

  request: {
    url: {{baseUrl}}/v1/hermes/runs/:id/approval
    method: POST
    mode: json
    params:path: {
      id:
    }

    body:json: {
      {
        "choice": "once"
      }
    }
  }

  response: {
    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 410 Response
  description: Hermes expired the run (`hermes_run_expired`).

  request: {
    url: {{baseUrl}}/v1/hermes/runs/:id/approval
    method: POST
    mode: json
    params:path: {
      id:
    }

    body:json: {
      {
        "choice": "once"
      }
    }
  }

  response: {
    status: {
      code: 410
      text: Gone
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 502 Response
  description: Hermes gateway error (`hermes_runs_upstream_error`).

  request: {
    url: {{baseUrl}}/v1/hermes/runs/:id/approval
    method: POST
    mode: json
    params:path: {
      id:
    }

    body:json: {
      {
        "choice": "once"
      }
    }
  }

  response: {
    status: {
      code: 502
      text: Bad Gateway
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
