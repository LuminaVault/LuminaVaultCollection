meta {
  name: List the tenant's Hermes runs, newest first
  type: http
  seq: 2
  tags: [
    Hermes_Runs
  ]
}

get {
  url: {{baseUrl}}/v1/hermes/runs
  body: none
  auth: inherit
}

params:query {
  limit: 20
  @description('''
    Narrow to the runs started by one conversation. This is how a chat
    client recovers after losing the stream that carried a run's id —
    it asks which runs belong to the conversation instead of scanning
    the tenant's whole history. Runs started from the Agent Runs screen
    have no conversation and never match. An unparseable value is
    treated as absent rather than rejected, so a malformed link
    degrades to the full list instead of a 400.

  ''')
  ~conversationID:
}

example {
  name: 200 Response
  description: Persisted runs.

  request: {
    url: {{baseUrl}}/v1/hermes/runs
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~conversationID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "runs": [
            {
              "id": "",
              "hermesRunID": "",
              "status": "queued",
              "prompt": "",
              "sessionID": "",
              "model": "",
              "conversationID": "",
              "startedAt": "",
              "finishedAt": "",
              "lastEvent": "",
              "lastSeq": 0,
              "pendingApproval": "",
              "summary": "",
              "error": ""
            }
          ]
        }
      '''
    }
  }
}
