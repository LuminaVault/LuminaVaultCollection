  request: {
    url: {{baseUrl}}/v1/hermes/runs/:id/stop
    method: POST
    mode: none
    params:path: {
      id:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}

example {
  name: 502 Response
  description: Hermes gateway error (`hermes_runs_upstream_error`).

  request: {
    url: {{baseUrl}}/v1/hermes/runs/:id/stop
    method: POST
    mode: none
    params:path: {
      id:
    }
  }

  response: {
    status: {
      code: 502
      text: Bad Gateway
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
