meta {
  name: Capture a URL with async OG / YouTube / X enrichment (HER-149)
  type: http
  seq: 1
  tags: [
    Capture
  ]
}

post {
  url: {{baseUrl}}/v1/capture/safari
  body: json
  auth: inherit
}

body:json {
  {
    "url": "",
    "notes": "",
    "space_id": ""
  }
}

example {
  name: 200 Response
  description: Capture queued; vault file id returned.

  request: {
    url: {{baseUrl}}/v1/capture/safari
    method: POST
    mode: json
    body:json: {
      {
        "url": "",
        "notes": "",
        "space_id": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "path": "",
          "status": ""
        }
      '''
    }
  }
}

example {
  name: insufficientStorage

  request: {
    url: {{baseUrl}}/v1/capture/safari
    method: POST
    mode: json
    body:json: {
      {
        "url": "",
        "notes": "",
        "space_id": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 507
      text: Insufficient Storage
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "insufficient_storage",
            "message": "LuminaVault is short on storage space right now, so this wasn't saved. Please try again later."
          }
        }
      '''
    }
  }
}
