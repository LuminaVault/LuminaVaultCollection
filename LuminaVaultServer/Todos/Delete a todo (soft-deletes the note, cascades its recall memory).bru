meta {
  name: Delete a todo (soft-deletes the note, cascades its recall memory)
  type: http
  seq: 4
  tags: [
    Todos
  ]
}

delete {
  url: {{baseUrl}}/v1/todos/:id
  body: none
  auth: inherit
}

params:path {
  id:
}

example {
  name: 204 Response
  description: Row deleted.

  request: {
    url: {{baseUrl}}/v1/todos/:id
    method: DELETE
    mode: none
    params:path: {
      id:
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 404 Response
  description: Unknown todo.

  request: {
    url: {{baseUrl}}/v1/todos/:id
    method: DELETE
    mode: none
    params:path: {
      id:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
