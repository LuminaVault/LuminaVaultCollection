meta {
  name: Set this persona as the tenant's default
  type: http
  seq: 6
  tags: [
    Profiles
  ]
}

post {
  url: {{baseUrl}}/v1/profiles/:slug/activate
  body: none
  auth: inherit
}

params:path {
  slug:
}

docs {
  Atomically clears the prior default and flags this slug.
  Subsequent chat requests with no `X-Hermes-Profile` header
  will resolve to this slug. Idempotent: activating the
  already-default persona is a no-op.

}

example {
  name: 200 Response
  description: Activation acknowledged.

  request: {
    url: {{baseUrl}}/v1/profiles/:slug/activate
    method: POST
    mode: none
    params:path: {
      slug:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "slug": "",
          "activatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Unknown persona (`profile_not_found`).

  request: {
    url: {{baseUrl}}/v1/profiles/:slug/activate
    method: POST
    mode: none
    params:path: {
      slug:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
