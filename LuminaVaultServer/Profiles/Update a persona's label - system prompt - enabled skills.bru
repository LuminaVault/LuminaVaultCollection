meta {
  name: Update a persona's label / system prompt / enabled skills
  type: http
  seq: 4
  tags: [
    Profiles
  ]
}

patch {
  url: {{baseUrl}}/v1/profiles/:slug
  body: json
  auth: inherit
}

params:path {
  slug:
}

body:json {
  {
    "label": "",
    "systemPrompt": "",
    "skillsEnabled": []
  }
}

docs {
  Slug and default flag are immutable here; use
  `POST /v1/profiles/{slug}/activate` to switch the default.
  Any unset field is left unchanged.

}

example {
  name: 200 Response
  description: Updated persona.

  request: {
    url: {{baseUrl}}/v1/profiles/:slug
    method: PATCH
    mode: json
    params:path: {
      slug:
    }

    body:json: {
      {
        "label": "",
        "systemPrompt": "",
        "skillsEnabled": []
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "slug": "",
          "label": "",
          "systemPrompt": "",
          "isDefault": false,
          "skillsEnabled": [],
          "createdAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: '''
    Stable codes in `message`:
    `invalid_label`, `system_prompt_too_long`.

  '''

  request: {
    url: {{baseUrl}}/v1/profiles/:slug
    method: PATCH
    mode: json
    params:path: {
      slug:
    }

    body:json: {
      {
        "label": "",
        "systemPrompt": "",
        "skillsEnabled": []
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Unknown persona (`profile_not_found`).

  request: {
    url: {{baseUrl}}/v1/profiles/:slug
    method: PATCH
    mode: json
    params:path: {
      slug:
    }

    body:json: {
      {
        "label": "",
        "systemPrompt": "",
        "skillsEnabled": []
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
