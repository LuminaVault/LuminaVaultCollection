  name: 409 Response
  description: A chain is already running in this room.

  request: {
    url: {{baseUrl}}/v1/agents/rooms/:room/messages
    method: POST
    mode: json
    params:path: {
      room:
    }

    body:json: {
      {
        "body": ""
      }
    }
  }

  response: {
    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
