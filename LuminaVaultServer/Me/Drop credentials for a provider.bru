meta {
  name: Drop credentials for a provider
  type: http
  seq: 11
  tags: [
    Me
  ]
}

delete {
  url: {{baseUrl}}/v1/me/providers/:provider
  body: none
  auth: inherit
}

params:path {
  provider: xai
  provider: anthropic
  provider: openai
  provider: ollama
  provider: openRouter
  provider: nvidia
  provider: gemini
  provider: nous
  provider: custom
}

example {
  name: 204 Response
  description: Row deleted (idempotent — 204 even if absent).

  request: {
    url: {{baseUrl}}/v1/me/providers/:provider
    method: DELETE
    mode: none
    params:path: {
      provider: xai
      ~provider: anthropic
      ~provider: openai
      ~provider: ollama
      ~provider: openRouter
      ~provider: nvidia
      ~provider: gemini
      ~provider: nous
      ~provider: custom
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
