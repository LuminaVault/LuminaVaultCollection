meta {
  name: Update per-tenant APNS category opt-out (HER-179)
  type: http
  seq: 7
  tags: [
    Me
  ]
}

put {
  url: {{baseUrl}}/v1/me/apns-categories
  body: json
  auth: inherit
}

body:json {
  {
    "chatEnabled": false,
    "nudgeEnabled": false,
    "digestEnabled": false,
    "approvalEnabled": false,
    "runCompletedEnabled": false
  }
}

example {
  name: 200 Response
  description: Updated preferences.

  request: {
    url: {{baseUrl}}/v1/me/apns-categories
    method: PUT
    mode: json
    body:json: {
      {
        "chatEnabled": false,
        "nudgeEnabled": false,
        "digestEnabled": false,
        "approvalEnabled": false,
        "runCompletedEnabled": false
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "chatEnabled": false,
          "nudgeEnabled": false,
          "digestEnabled": false,
          "approvalEnabled": false,
          "runCompletedEnabled": false
        }
      '''
    }
  }
}
