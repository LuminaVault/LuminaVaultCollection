meta {
  name: Upsert credentials for a provider
  type: http
  seq: 10
  tags: [
    Me
  ]
}

put {
  url: {{baseUrl}}/v1/me/providers/:provider
  body: json
  auth: inherit
}

params:path {
  provider: xai
  provider: anthropic
  provider: openai
  provider: ollama
  provider: openRouter
  provider: nvidia
  provider: gemini
  provider: nous
  provider: custom
}

body:json {
  {
    "kind": "apiKey",
    "apiKey": "",
    "baseUrl": "",
    "label": ""
  }
}

example {
  name: 200 Response
  description: Updated record (verifiedAt + lastFailure* reset).

  request: {
    url: {{baseUrl}}/v1/me/providers/:provider
    method: PUT
    mode: json
    params:path: {
      provider: xai
      ~provider: anthropic
      ~provider: openai
      ~provider: ollama
      ~provider: openRouter
      ~provider: nvidia
      ~provider: gemini
      ~provider: nous
      ~provider: custom
    }

    body:json: {
      {
        "kind": "apiKey",
        "apiKey": "",
        "baseUrl": "",
        "label": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "provider": "xai",
          "kind": "apiKey",
          "hasCredential": false,
          "baseUrl": "",
          "label": "",
          "verifiedAt": "",
          "lastFailureAt": "",
          "lastFailureCode": "",
          "supportsTools": false,
          "toolsProbedAt": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Validation error (api_key_required / base_url_required / invalid_base_url).

  request: {
    url: {{baseUrl}}/v1/me/providers/:provider
    method: PUT
    mode: json
    params:path: {
      provider: xai
      ~provider: anthropic
      ~provider: openai
      ~provider: ollama
      ~provider: openRouter
      ~provider: nvidia
      ~provider: gemini
      ~provider: nous
      ~provider: custom
    }

    body:json: {
      {
        "kind": "apiKey",
        "apiKey": "",
        "baseUrl": "",
        "label": ""
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
