meta {
  name: Mark a commitment done, dropped, or open again
  type: http
  seq: 9
  tags: [
    Me
  ]
}

patch {
  url: {{baseUrl}}/v1/me/commitments/:id
  body: json
  auth: inherit
}

params:path {
  id:
}

body:json {
  {
    "state": "open"
  }
}

docs {
  `done` and `dropped` stamp `doneAt`; `open` clears it. Done and
  dropped commitments never appear in a brief again.

}

example {
  name: 200 Response
  description: The updated commitment.

  request: {
    url: {{baseUrl}}/v1/me/commitments/:id
    method: PATCH
    mode: json
    params:path: {
      id:
    }

    body:json: {
      {
        "state": "open"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "text": "",
          "dueAt": "",
          "state": "open",
          "surfacedCount": 0,
          "memoryId": "",
          "sourceVaultFileId": "",
          "createdAt": "",
          "doneAt": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid id, or `state` is not open, done or dropped.

  request: {
    url: {{baseUrl}}/v1/me/commitments/:id
    method: PATCH
    mode: json
    params:path: {
      id:
    }

    body:json: {
      {
        "state": "open"
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

