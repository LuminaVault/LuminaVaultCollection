  request: {
    url: {{baseUrl}}/v1/me/commitments/:id
    method: PATCH
    mode: json
    params:path: {
      id:
    }

    body:json: {
      {
        "state": "open"
      }
    }
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 404 Response
  description: No such commitment for this user (another user's id is a 404 too).

  request: {
    url: {{baseUrl}}/v1/me/commitments/:id
    method: PATCH
    mode: json
    params:path: {
      id:
    }

    body:json: {
      {
        "state": "open"
      }
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 409 Response
  description: Reopening it would duplicate a commitment that is already open with the same text.

  request: {
    url: {{baseUrl}}/v1/me/commitments/:id
    method: PATCH
    mode: json
    params:path: {
      id:
    }

    body:json: {
      {
        "state": "open"
      }
    }
  }

  response: {
    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 429 Response
  description: Rate-limit exceeded; honour `Retry-After`.

  request: {
    url: {{baseUrl}}/v1/me/commitments/:id
    method: PATCH
    mode: json
    params:path: {
      id:
    }

    body:json: {
      {
        "state": "open"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
