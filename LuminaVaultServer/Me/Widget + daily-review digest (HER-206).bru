meta {
  name: Widget + daily-review digest (HER-206)
  type: http
  seq: 4
  tags: [
    Me
  ]
}

get {
  url: {{baseUrl}}/v1/me/today
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: Today snapshot.

  request: {
    url: {{baseUrl}}/v1/me/today
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "date": "",
          "memories": [
            {
              "id": "",
              "content": "",
              "tags": [],
              "score": 0,
              "accessCount": 0,
              "queryHitCount": 0,
              "lastAccessedAt": "",
              "createdAt": "",
              "updatedAt": "",
              "sourceVaultFileId": "",
              "reviewState": "auto",
              "provenance": {
                "createdBy": {
                  "id": "",
                  "operation": "create",
                  "actor": "user",
                  "source": "manual",
                  "model": {
                    "provider": "",
                    "model": ""
                  },
                  "sourceReference": "",
                  "createdAt": ""
                },
                "lastUpdatedBy": {
                  "id": "",
                  "operation": "create",
                  "actor": "user",
                  "source": "manual",
                  "model": {
                    "provider": "",
                    "model": ""
                  },
                  "sourceReference": "",
                  "createdAt": ""
                },
                "contributors": [
                  {
                    "provider": "",
                    "model": ""
                  }
                ]
              }
            }
          ],
          "achievements": [
            {
              "key": "",
              "title": "",
              "description": "",
              "tier": "",
              "progressCount": 0,
              "targetCount": 0,
              "unlockedAt": ""
            }
          ],
          "soulExcerpt": "",
          "suggestedActions": []
        }
      '''
    }
  }
}

example {
  name: 429 Response
  description: Rate-limit exceeded; honour `Retry-After`.

  request: {
    url: {{baseUrl}}/v1/me/today
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
