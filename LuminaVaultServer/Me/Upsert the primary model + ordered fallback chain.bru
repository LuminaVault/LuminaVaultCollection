meta {
  name: Upsert the primary model + ordered fallback chain
  type: http
  seq: 27
  tags: [
    Me
  ]
}

put {
  url: {{baseUrl}}/v1/me/preferences/llm
  body: json
  auth: inherit
}

body:json {
  {
    "mode": "managed",
    "primaryProvider": "xai",
    "primaryModel": "",
    "fallbackChain": [
      {
        "provider": "xai",
        "model": ""
      }
    ],
    "allowedProviders": [
      "xai"
    ],
    "blockedProviders": [
      "xai"
    ]
  }
}

