meta {
  name: Upsert cross-device chat behavior preferences
  type: http
  seq: 29
  tags: [
    Me
  ]
}

put {
  url: {{baseUrl}}/v1/me/chat-preferences
  body: json
  auth: inherit
}

body:json {
  {
    "preferences": {
      "autoExpandThinking": false,
      "sendOnReturn": false
    }
  }
}

example {
  name: 200 Response
  description: Updated chat preference snapshot.

  request: {
    url: {{baseUrl}}/v1/me/chat-preferences
    method: PUT
    mode: json
    body:json: {
      {
        "preferences": {
          "autoExpandThinking": false,
          "sendOnReturn": false
        }
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "preferences": {
            "autoExpandThinking": false,
            "sendOnReturn": false
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing / invalid credential.

  request: {
    url: {{baseUrl}}/v1/me/chat-preferences
    method: PUT
    mode: json
    body:json: {
      {
        "preferences": {
          "autoExpandThinking": false,
          "sendOnReturn": false
        }
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
