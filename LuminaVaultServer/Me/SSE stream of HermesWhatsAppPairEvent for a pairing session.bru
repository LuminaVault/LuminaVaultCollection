meta {
  name: SSE stream of HermesWhatsAppPairEvent for a pairing session
  type: http
  seq: 24
  tags: [
    Me
  ]
}

get {
  url: {{baseUrl}}/v1/me/hermes-gateways/whatsapp/pair/:sessionID/stream
  body: none
  auth: inherit
}

params:path {
  sessionID:
}

docs {
  `text/event-stream`; each `data:` line is one JSON-encoded `HermesWhatsAppPairEvent` (discriminated by `type`: `qr` | `status` | `linked` | `error`), blank-line terminated. The latest QR + status are replayed on connect.

}

example {
  name: 200 Response
  description: Event stream.

  request: {
    url: {{baseUrl}}/v1/me/hermes-gateways/whatsapp/pair/:sessionID/stream
    method: GET
    mode: none
    params:path: {
      sessionID:
    }
  }

  response: {
    headers: {
      Content-Type: text/event-stream
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 400 Response
  description: `invalid_session_id`.

  request: {
    url: {{baseUrl}}/v1/me/hermes-gateways/whatsapp/pair/:sessionID/stream
    method: GET
    mode: none
    params:path: {
      sessionID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
