meta {
  name: Probe the credential with a 1-token chat request
  type: http
  seq: 12
  tags: [
    Me
  ]
}

post {
  url: {{baseUrl}}/v1/me/providers/:provider/test
  body: none
  auth: inherit
}

params:path {
  provider: xai
  provider: anthropic
  provider: openai
  provider: ollama
  provider: openRouter
  provider: nvidia
  provider: gemini
  provider: nous
  provider: custom
}

docs {
  Builds a one-off adapter using the stored credential and sends a
  `max_tokens: 1` request. On 2xx the row's `verifiedAt` is stamped
  and `lastFailure*` cleared. On any other outcome the row is
  marked failed and a stable code is returned.

}

example {
  name: 200 Response
  description: Verified.

  request: {
    url: {{baseUrl}}/v1/me/providers/:provider/test
    method: POST
    mode: none
    params:path: {
      provider: xai
      ~provider: anthropic
      ~provider: openai
      ~provider: ollama
      ~provider: openRouter
      ~provider: nvidia
      ~provider: gemini
      ~provider: nous
      ~provider: custom
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "verifiedAt": "",
          "model": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: '''
    Stable code in `message`:
    `no_credential` (no stored row) /
    `unsupported_provider` (unknown path param).

  '''

  request: {
    url: {{baseUrl}}/v1/me/providers/:provider/test
    method: POST
    mode: none
    params:path: {
      provider: xai
      ~provider: anthropic
      ~provider: openai
      ~provider: ollama
      ~provider: openRouter
      ~provider: nvidia
      ~provider: gemini
      ~provider: nous
      ~provider: custom
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}

example {
  name: 502 Response
  description: '''
    Probe failed. Stable code in `message`:
    `credit_exhausted` / `rate_limit` / `upstream_error` /
    `upstream_rejected` / `network` / `tls_error` / `timeout`.

  '''

  request: {
    url: {{baseUrl}}/v1/me/providers/:provider/test
    method: POST
    mode: none
    params:path: {
      provider: xai
      ~provider: anthropic
      ~provider: openai
      ~provider: ollama
      ~provider: openRouter
      ~provider: nvidia
      ~provider: gemini
      ~provider: nous
      ~provider: custom
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 502
      text: Bad Gateway
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
