meta {
  name: The user's commitments (open loops kb-compile found in their notes)
  type: http
  seq: 8
  tags: [
    Me
  ]
}

get {
  url: {{baseUrl}}/v1/me/commitments
  body: none
  auth: inherit
}

params:query {
  @description('Which commitments to list. Default `open`; anything else is a 400.')
  state: open
  @description('Which commitments to list. Default `open`; anything else is a 400.')
  ~state: done
  @description('Which commitments to list. Default `open`; anything else is a 400.')
  ~state: dropped
  @description('Which commitments to list. Default `open`; anything else is a 400.')
  ~state: all
}

docs {
  First-person promises ("I'll…", "I need to…", "I promised…") that
  kb-compile extracted from the user's own notes. Deterministic read, no
  model call. Open ones come due first (soonest), then oldest; done and
  dropped ones most recently closed first. At most 200.

  Up to three open ones ride in the daily brief's "Open loops" card,
  each in at most three briefs (`surfacedCount`); after that they live
  only here.

}

example {
  name: 200 Response
  description: The commitments; may be empty.

  request: {
    url: {{baseUrl}}/v1/me/commitments
    method: GET
    mode: none
    params:query: {
      state: open
      ~state: done
      ~state: dropped
      ~state: all
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "items": [
            {
              "id": "",
              "text": "",
              "dueAt": "",
              "state": "open",
              "surfacedCount": 0,
              "memoryId": "",
              "sourceVaultFileId": "",
              "createdAt": "",
              "doneAt": ""
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: `state` is not open, done, dropped or all.

  request: {
    url: {{baseUrl}}/v1/me/commitments
    method: GET
    mode: none
    params:query: {
      state: open
      ~state: done
      ~state: dropped
      ~state: all
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing or invalid token.

  request: {
    url: {{baseUrl}}/v1/me/commitments
    method: GET
    mode: none
    params:query: {
      state: open
      ~state: done
      ~state: dropped
      ~state: all
    }
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 429 Response
  description: Rate-limit exceeded; honour `Retry-After`.

  request: {
    url: {{baseUrl}}/v1/me/commitments
    method: GET
    mode: none
    params:query: {
      state: open
      ~state: done
      ~state: dropped
      ~state: all
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
