meta {
  name: List per-user external LLM provider credentials (HER-252)
  type: http
  seq: 8
  tags: [
    Me
  ]
}

get {
  url: {{baseUrl}}/v1/me/providers
  body: none
  auth: inherit
}

docs {
  Returns one row per supported provider. Plaintext credentials are
  never echoed — only `hasCredential` and metadata. Providers with
  no row are returned with `hasCredential: false`.

}

example {
  name: 200 Response
  description: List of provider credential records.

  request: {
    url: {{baseUrl}}/v1/me/providers
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "providers": [
            {
              "provider": "xai",
              "kind": "apiKey",
              "hasCredential": false,
              "baseUrl": "",
              "label": "",
              "verifiedAt": "",
              "lastFailureAt": "",
              "lastFailureCode": "",
              "supportsTools": false,
              "toolsProbedAt": ""
            }
          ]
        }
      '''
    }
  }
}
