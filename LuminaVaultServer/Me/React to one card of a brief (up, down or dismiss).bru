meta {
  name: React to one card of a brief (up, down or dismiss)
  type: http
  seq: 11
  tags: [
    Me
  ]
}

post {
  url: {{baseUrl}}/v1/me/brief/:briefId/cards/:cardId/feedback
  body: json
  auth: inherit
}

params:path {
  briefId:
  @description("The card's `id` within that brief (e.g. `weather`, `openLoops`).")
  cardId:
}

body:json {
  {
    "action": "up"
  }
}

docs {
  One reaction per card per brief; a second one replaces the first.
  Feeds the ordering of later briefs (see `GET /v1/me/brief`). A
  `down` on a `toRevisit` card also means "later" for its memory: the
  same 30-day snooze as `POST /v1/memory/{id}/review` with
  `{"action": "later"}`.

}

example {
  name: 204 Response
  description: Recorded.

  request: {
    url: {{baseUrl}}/v1/me/brief/:briefId/cards/:cardId/feedback
    method: POST
    mode: json
    params:path: {
      briefId:
      cardId:
    }

    body:json: {
      {
        "action": "up"
      }
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

