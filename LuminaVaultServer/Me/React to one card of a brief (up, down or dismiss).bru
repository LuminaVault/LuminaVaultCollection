example {
  name: 429 Response
  description: Rate-limit exceeded; honour `Retry-After`.

  request: {
    url: {{baseUrl}}/v1/me/brief/:briefId/cards/:cardId/feedback
    method: POST
    mode: json
    params:path: {
      briefId:
      cardId:
    }

    body:json: {
      {
        "action": "up"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
