example {
  name: 404 Response
  description: No such brief for this user, or no such card in it.

  request: {
    url: {{baseUrl}}/v1/me/brief/:briefId/cards/:cardId/feedback
    method: POST
    mode: json
    params:path: {
      briefId:
      cardId:
    }

    body:json: {
