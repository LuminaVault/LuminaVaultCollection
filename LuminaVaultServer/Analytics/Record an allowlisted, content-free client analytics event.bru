meta {
  name: Record an allowlisted, content-free client analytics event
  type: http
  seq: 6
  tags: [
    Analytics
  ]
}

post {
  url: {{baseUrl}}/v1/analytics/events
  body: json
  auth: inherit
}

body:json {
  {
    "name": "analytics_dashboard_viewed",
    "source": "ios",
    "range": "7d",
    "recommendationId": "",
    "idempotencyKey": ""
  }
}

example {
  name: 200 Response
  description: Event accepted.

  request: {
    url: {{baseUrl}}/v1/analytics/events
    method: POST
    mode: json
    body:json: {
      {
        "name": "analytics_dashboard_viewed",
        "source": "ios",
        "range": "7d",
        "recommendationId": "",
        "idempotencyKey": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "accepted": false
        }
      '''
    }
  }
}
