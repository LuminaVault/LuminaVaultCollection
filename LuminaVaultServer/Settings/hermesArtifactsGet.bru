meta {
  name: hermesArtifactsGet
  type: http
  seq: 8
  tags: [
    Settings
  ]
}

get {
  url: {{baseUrl}}/v1/hermes/artifacts/:id
  body: none
  auth: inherit
}

params:path {
  id:
}

example {
  name: 200 Response
  description: One artifact.

  request: {
    url: {{baseUrl}}/v1/hermes/artifacts/:id
    method: GET
    mode: none
    params:path: {
      id:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "kind": "image",
          "value": "",
          "href": "",
          "label": "",
          "sessionID": "",
          "sessionTitle": "",
          "occurredAt": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: `hermes_artifact_not_found`.

  request: {
    url: {{baseUrl}}/v1/hermes/artifacts/:id
    method: GET
    mode: none
    params:path: {
      id:
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
