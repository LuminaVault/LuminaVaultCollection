meta {
  name: Create a cron job on the tenant's Hermes.
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/hermes/mirror/jobs
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "schedule": "",
    "prompt": "",
    "deliver": "",
    "skills": [],
    "model": "",
    "provider": "",
    "baseURL": "",
    "script": "",
    "contextFrom": [],
    "enabledToolsets": [],
    "workdir": "",
    "noAgent": false
  }
}
