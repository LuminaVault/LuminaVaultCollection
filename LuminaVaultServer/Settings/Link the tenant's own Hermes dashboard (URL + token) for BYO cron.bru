meta {
  name: Link the tenant's own Hermes dashboard (URL + token) for BYO cron
  type: http
  seq: 6
  tags: [
    Settings
  ]
}

put {
  url: {{baseUrl}}/v1/me/hermes/cron/config
  body: json
  auth: inherit
}

body:json {
  {
    "dashboardUrl": "",
    "dashboardToken": ""
  }
}

docs {
  Stores the BYO Hermes **dashboard** endpoint and its static bearer
  token, then immediately lists the tenant's cron jobs through it — so
  the response doubles as a probe of the credentials just saved.

  `dashboardToken` is write-only: it is sealed with `SecretBox` into the
  `cron_dashboard` columns and never returned by any read endpoint. To
  change it, send the pair again.

  The dashboard only honours a static bearer when it is **bound to
  loopback behind the operator's own TLS proxy or tunnel**. A
  non-loopback bind falls back to an OAuth/password gate that has no
  bearer path, and this route answers
  `502 hermes_dashboard_auth_mode_unsupported` — the credentials are
  saved, but nothing can be driven through them until the bind changes.

}

example {
  name: 200 Response
  description: '''
    Credentials stored and accepted. Body is the now-listable jobs,
    with `source` = `managed` when a managed container exists for the
    tenant (it wins over BYO) or `byo` otherwise.

  '''

  request: {
    url: {{baseUrl}}/v1/me/hermes/cron/config
    method: PUT
    mode: json
    body:json: {
      {
        "dashboardUrl": "",
        "dashboardToken": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "source": "managed",
          "jobs": [
            {
              "id": "",
              "name": "",
              "schedule": "",
              "deliver": "",
              "lastRun": "",
              "status": "",
              "mode": ""
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Body missing or not decodable as `HermesCronConfigRequest`.

  request: {
    url: {{baseUrl}}/v1/me/hermes/cron/config
    method: PUT
    mode: json
    body:json: {
      {
        "dashboardUrl": "",
        "dashboardToken": ""
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 401 Response
  description: No tenant identity on the request (missing or invalid JWT).

  request: {
    url: {{baseUrl}}/v1/me/hermes/cron/config
    method: PUT
    mode: json
    body:json: {
      {
        "dashboardUrl": "",
        "dashboardToken": ""
      }
    }
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 500 Response
  description: '''
    `dashboardUrl` failed `SSRFGuard.validate` (bad URL, disallowed
    scheme, missing host, loopback / private / link-local / unresolvable
    address). The guard's rejection is not translated here, so it
    surfaces as an untyped 500 rather than the
    `invalid_base_url:<reason>` 400 that `PUT /v1/settings/hermes`
    returns.

  '''

  request: {
    url: {{baseUrl}}/v1/me/hermes/cron/config
    method: PUT
    mode: json
    body:json: {
      {
        "dashboardUrl": "",
        "dashboardToken": ""
      }
    }
  }

  response: {
    status: {
      code: 500
      text: Internal Server Error
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 502 Response
  description: '''
    Saved, but the follow-up list against the dashboard failed.
    `message` is a stable code:
    `hermes_dashboard_auth_mode_unsupported` (dashboard behind its
    OAuth/password gate — bind it to loopback behind your own TLS proxy
    or tunnel), `byo_cron_http_401` (token rejected),
    `byo_cron_http_<status>` (any other upstream status),
    `hermes_dashboard_unreachable`, `hermes_mirror_invalid_response`,
    `hermes_mirror_body_too_large`, `hermes_mirror_unsupported`.

  '''

  request: {
    url: {{baseUrl}}/v1/me/hermes/cron/config
    method: PUT
    mode: json
    body:json: {
      {
        "dashboardUrl": "",
        "dashboardToken": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 502
      text: Bad Gateway
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
