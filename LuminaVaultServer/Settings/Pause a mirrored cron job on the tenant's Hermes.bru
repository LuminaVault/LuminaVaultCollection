meta {
  name: Pause a mirrored cron job on the tenant's Hermes
  type: http
  seq: 15
  tags: [
    Settings
  ]
}

post {
  url: {{baseUrl}}/v1/hermes/mirror/jobs/:id/pause
  body: none
  auth: inherit
}

params:path {
  id:
}

example {
  name: 200 Response
  description: The job with `paused: true`.

  request: {
    url: {{baseUrl}}/v1/hermes/mirror/jobs/:id/pause
    method: POST
    mode: none
    params:path: {
      id:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "hermesJobID": "",
          "name": "",
          "schedule": "",
          "prompt": "",
          "paused": false,
          "lastRunAt": "",
          "nextRunAt": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: The job is not mirrored for this tenant (`hermes_job_not_found`).

  request: {
    url: {{baseUrl}}/v1/hermes/mirror/jobs/:id/pause
    method: POST
    mode: none
    params:path: {
      id:
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
