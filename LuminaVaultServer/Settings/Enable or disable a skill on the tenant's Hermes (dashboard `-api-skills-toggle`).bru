meta {
  name: Enable or disable a skill on the tenant's Hermes (dashboard `/api/skills/toggle`)
  type: http
  seq: 10
  tags: [
    Settings
  ]
}

put {
  url: {{baseUrl}}/v1/hermes/mirror/skills/:name
  body: json
  auth: inherit
}

params:path {
  name:
}

body:json {
  {
    "enabled": false
  }
}

example {
  name: 200 Response
  description: Updated skill.

  request: {
    url: {{baseUrl}}/v1/hermes/mirror/skills/:name
    method: PUT
    mode: json
    params:path: {
      name:
    }

    body:json: {
      {
        "enabled": false
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "name": "",
          "description": "",
          "enabled": false,
          "source": "builtin",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Skill not in the mirror (`hermes_skill_not_found`).

  request: {
    url: {{baseUrl}}/v1/hermes/mirror/skills/:name
    method: PUT
    mode: json
    params:path: {
      name:
    }

    body:json: {
      {
        "enabled": false
      }
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 502 Response
  description: '''
    Hermes refused or was unreachable. `message` is a stable code:
    `hermes_dashboard_auth_mode_unsupported` (dashboard behind the OAuth gate —
    bind it to loopback behind your own TLS proxy or tunnel),
    `hermes_dashboard_unauthorized`, `hermes_dashboard_unreachable`,
    `hermes_mirror_upstream_error`.

  '''

  request: {
    url: {{baseUrl}}/v1/hermes/mirror/skills/:name
    method: PUT
    mode: json
    params:path: {
      name:
    }

    body:json: {
      {
        "enabled": false
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 502
      text: Bad Gateway
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
