meta {
  name: Get the per-user Hermes gateway override (HER-217)
  type: http
  seq: 1
  tags: [
    Settings
  ]
}

get {
  url: {{baseUrl}}/v1/settings/hermes
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: Override config.

  request: {
    url: {{baseUrl}}/v1/settings/hermes
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "baseUrl": "",
          "hasAuthHeader": false,
          "verifiedAt": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: No row — falling back to managed default.

  request: {
    url: {{baseUrl}}/v1/settings/hermes
    method: GET
    mode: none
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
