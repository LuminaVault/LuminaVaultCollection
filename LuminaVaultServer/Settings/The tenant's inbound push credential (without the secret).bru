meta {
  name: The tenant's inbound push credential (without the secret)
  type: http
  seq: 24
  tags: [
    Settings
  ]
}

get {
  url: {{baseUrl}}/v1/hermes/mirror/webhook
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: Path, token and signing envelope. `secret` is never returned here.

  request: {
    url: {{baseUrl}}/v1/hermes/mirror/webhook
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "path": "",
          "token": "",
          "secret": "",
          "signatureHeader": "",
          "timestampHeader": "",
          "replayWindowSeconds": 0,
          "rotatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: No webhook has been minted for this tenant (`hermes_webhook_not_configured`).

  request: {
    url: {{baseUrl}}/v1/hermes/mirror/webhook
    method: GET
    mode: none
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
