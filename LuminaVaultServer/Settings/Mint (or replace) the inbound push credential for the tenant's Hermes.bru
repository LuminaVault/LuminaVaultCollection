meta {
  name: Mint (or replace) the inbound push credential for the tenant's Hermes
  type: http
  seq: 25
  tags: [
    Settings
  ]
}

post {
  url: {{baseUrl}}/v1/hermes/mirror/webhook
  body: none
  auth: inherit
}

docs {
  Returns the signing `secret` exactly once — LuminaVault seals it and
  never hands it back. Store it, and the `path`, on the tenant's Hermes.

  Requires that Hermes to report `admin_config_rw`: without it the user
  cannot save the URL and secret on their own side, so a credential
  would be a dead end. Tenants on the managed Hermes always qualify;
  anything else degrades to `hermes_admin_config_rw_required` and keeps
  polling, which is the source of truth either way.

}

example {
  name: 200 Response
  description: The new credential, including the one-time `secret`.

  request: {
    url: {{baseUrl}}/v1/hermes/mirror/webhook
    method: POST
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "path": "",
          "token": "",
          "secret": "",
          "signatureHeader": "",
          "timestampHeader": "",
          "replayWindowSeconds": 0,
          "rotatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: The tenant's Hermes does not report `admin_config_rw` (`hermes_admin_config_rw_required`).

  request: {
    url: {{baseUrl}}/v1/hermes/mirror/webhook
    method: POST
    mode: none
  }

  response: {
    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
