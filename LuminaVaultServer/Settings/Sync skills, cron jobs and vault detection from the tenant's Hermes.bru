meta {
  name: Sync skills, cron jobs and vault detection from the tenant's Hermes
  type: http
  seq: 8
  tags: [
    Settings
  ]
}

post {
  url: {{baseUrl}}/v1/hermes/mirror/sync
  body: json
  auth: inherit
}

body:json {
  {
    "scope": [
      "skills"
    ]
  }
}

docs {
  Each scope runs independently; failures are recorded on the status
  (`lastStatus` `partial` / `failed`, `lastError`) rather than thrown.
  An empty or absent `scope` syncs everything.

}

example {
  name: 200 Response
  description: Refreshed status.

  request: {
    url: {{baseUrl}}/v1/hermes/mirror/sync
    method: POST
    mode: json
    body:json: {
      {
        "scope": [
          "skills"
        ]
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "transport": "managed",
          "lastSyncAt": "",
          "lastStatus": "never",
          "lastError": "",
          "skillsCount": 0,
          "jobsCount": 0,
          "vaultFilesCount": 0,
          "vaultPath": "",
          "vaultState": "absent",
          "sessionsImported": 0,
          "compileJobID": "",
          "dashboard": {
            "reachable": false,
            "authMode": "bearer",
            "skillsWrite": false,
            "cron": false,
            "fs": false,
            "sessions": false,
            "version": "",
            "kbVaultPath": ""
          }
        }
      '''
    }
  }
}
