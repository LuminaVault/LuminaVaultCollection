meta {
  name: Images, files and links harvested from the tenant's Hermes sessions
  type: http
  seq: 7
  tags: [
    Settings
  ]
}

get {
  url: {{baseUrl}}/v1/hermes/artifacts
  body: none
  auth: inherit
}

params:query {
  limit: 50
  ~kind: image
  ~kind: file
  ~kind: link
  ~q:
  ~before:
  @description('''
    Narrow to one Hermes session, so a chat surface can show just the
    artifacts produced by the run behind the conversation on screen.
    Artifacts are keyed by session rather than conversation, so the
    join is conversation → run `sessionID` → artifacts; read the run's
    `sessionID` from `GET /v1/hermes/runs?conversationID=`. An empty
    value means no filter, which is what a client sends for a
    conversation that has not started a run yet.

  ''')
  ~sessionID:
}

example {
  name: 200 Response
  description: Newest first.

  request: {
    url: {{baseUrl}}/v1/hermes/artifacts
    method: GET
    mode: none
    params:query: {
      ~kind: image
      ~kind: file
      ~kind: link
      ~q:
      ~before:
      limit: 50
      ~sessionID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "artifacts": [
            {
              "id": "",
              "kind": "image",
              "value": "",
              "href": "",
              "label": "",
              "sessionID": "",
              "sessionTitle": "",
              "occurredAt": ""
            }
          ],
          "nextCursor": ""
        }
      '''
    }
  }
}
