meta {
  name: What the tenant's connected Hermes exposes, per settings domain (P3)
  type: http
  seq: 5
  tags: [
    Settings
  ]
}

get {
  url: {{baseUrl}}/v1/me/hermes/capabilities
  body: none
  auth: inherit
}

params:query {
  ~refresh:
}

docs {
  Managed tenants report every domain as `managed`. BYO-Hermes tenants
  get a cached probe of their remote `api_server` (`/v1/capabilities`
  + `/api/jobs`), mapping each domain to `live` / `read_only` /
  `unsupported` so clients can gate panes. Pass `?refresh=true` to
  force a re-probe past the cache TTL.

}

example {
  name: 200 Response
  description: Capabilities view.

  request: {
    url: {{baseUrl}}/v1/me/hermes/capabilities
    method: GET
    mode: none
    params:query: {
      ~refresh:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "capabilities": {
            "isUserOverride": false,
            "remoteVersion": "",
            "chat": "live",
            "sessions": "live",
            "jobs": "live",
            "skills": "live",
            "soul": "live",
            "gateways": "live",
            "memory": "live",
            "providers": "live",
            "multimodalIngestion": "live",
            "ingestionSupportedMimeTypes": [],
            "ingestionMaxSourceBytes": 0,
            "ingestionRemoteSourceURL": false,
            "dashboard": {
              "reachable": false,
              "authMode": "bearer",
              "skillsWrite": false,
              "cron": false,
              "fs": false,
              "sessions": false,
              "version": "",
              "kbVaultPath": ""
            }
          },
          "checkedAt": ""
        }
      '''
    }
  }
}
