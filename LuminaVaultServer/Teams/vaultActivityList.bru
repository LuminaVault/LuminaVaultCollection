  description: Recent vault activity

  request: {
    url: {{baseUrl}}/v1/vaults/:vaultID/activity
    method: GET
    mode: none
    params:path: {
      vaultID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
