}

example {
  name: 403 Response
  description: Reminders access not allowed by the user.

  request: {
    url: {{baseUrl}}/v1/reminders/sync
    method: POST
    mode: json
    body:json: {
      {
        "reminders": [
          {
            "externalID": "",
            "title": "",
            "notes": "",
            "dueAt": "",
            "completed": false,
            "completedAt": "",
            "listName": "",
            "priority": 0,
            "remoteUpdatedAt": ""
          }
        ]
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
