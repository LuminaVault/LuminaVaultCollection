meta {
  name: Delete a vault file by tenant-relative path
  type: http
  seq: 5
  tags: [
    Vault
  ]
}

delete {
  url: {{baseUrl}}/v1/vault/files/:path
  body: none
  auth: inherit
}

params:path {
  path:
}

headers {
  @description('''
    HER-39 — client-generated UUIDv4. Retrying a mutating request with the same key (within 24 h) replays the cached response instead of re-executing the handler. Reusing a key with a different request body returns 409. Tenant-scoped: the same key value across different tenants does not collide.

  ''')
  ~Idempotency-Key:
}

example {
  name: 204 Response
  description: Deleted.

  request: {
    url: {{baseUrl}}/v1/vault/files/:path
    method: DELETE
    mode: none
    params:path: {
      path:
    }

    headers: {
      ~Idempotency-Key:
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 404 Response
  description: Resource not found.

  request: {
    url: {{baseUrl}}/v1/vault/files/:path
    method: DELETE
    mode: none
    params:path: {
      path:
    }

    headers: {
      ~Idempotency-Key:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
