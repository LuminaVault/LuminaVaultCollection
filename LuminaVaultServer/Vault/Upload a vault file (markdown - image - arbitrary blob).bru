meta {
  name: Upload a vault file (markdown / image / arbitrary blob)
  type: http
  seq: 1
  tags: [
    Vault
  ]
}

post {
  url: {{baseUrl}}/v1/vault/files
  body: text
  auth: inherit
}

params:query {
  @description('Tenant-relative file path (e.g. `notes/today.md`).')
  path:
  @description('''
    Optional Space association (HER-CaptureTab). Must belong to the
    caller's tenant; cross-tenant UUIDs and malformed UUIDs both
    return 400. Omit to leave the file unfiled. On re-upload to an
    existing path, a provided value overwrites the prior link; an
    omitted value leaves the existing link intact.

  ''')
  ~space_id:
}

headers {
  @description('''
    HER-39 — client-generated UUIDv4. Retrying a mutating request with the same key (within 24 h) replays the cached response instead of re-executing the handler. Reusing a key with a different request body returns 409. Tenant-scoped: the same key value across different tenants does not collide.

  ''')
  ~Idempotency-Key:
}

docs {
  Raw-body upload. The relative path under `<rawRoot>/` is supplied via
  the `path` query param; the body bytes are written verbatim. The
  optional `space_id` query param associates the row with a Space the
  caller owns — used by the iOS Capture tab so first-tap captures land
  directly into the active Space without a separate move call.

}

example {
  name: 200 Response
  description: File stored.

  request: {
    url: {{baseUrl}}/v1/vault/files
    method: POST
    mode: text
    params:query: {
      path:
      ~space_id:
    }

    headers: {
      ~Idempotency-Key:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "path": "",
          "size": 0,
          "contentType": "",
          "sha256": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Malformed `path`, malformed `space_id`, cross-tenant space, empty body, or content-type mismatch.

  request: {
    url: {{baseUrl}}/v1/vault/files
    method: POST
    mode: text
    params:query: {
      path:
      ~space_id:
    }

    headers: {
      ~Idempotency-Key:
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
