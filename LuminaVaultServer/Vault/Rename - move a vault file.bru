meta {
  name: Rename / move a vault file
  type: http
  seq: 3
  tags: [
    Vault
  ]
}

post {
  url: {{baseUrl}}/v1/vault/files/move
  body: json
  auth: inherit
}

headers {
  @description('''
    HER-39 — client-generated UUIDv4. Retrying a mutating request with the same key (within 24 h) replays the cached response instead of re-executing the handler. Reusing a key with a different request body returns 409. Tenant-scoped: the same key value across different tenants does not collide.

  ''')
  ~Idempotency-Key:
}

body:json {
  {
    "from": "",
    "to": ""
  }
}

example {
  name: 200 Response
  description: Updated file.

  request: {
    url: {{baseUrl}}/v1/vault/files/move
    method: POST
    mode: json
    headers: {
      ~Idempotency-Key:
    }

    body:json: {
      {
        "from": "",
        "to": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "path": "",
          "contentType": "",
          "sizeBytes": 0,
          "sha256": "",
          "processedAt": "",
          "createdAt": "",
          "metadata": {}
        }
      '''
    }
  }
}
