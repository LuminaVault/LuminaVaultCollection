meta {
  name: Fetch a single memory
  type: http
  seq: 4
  tags: [
    Memory
  ]
}

get {
  url: {{baseUrl}}/v1/memory/:id
  body: none
  auth: inherit
}

params:path {
  id:
}

example {
  name: 200 Response
  description: Memory.

  request: {
    url: {{baseUrl}}/v1/memory/:id
    method: GET
    mode: none
    params:path: {
      id:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "content": "",
          "tags": [],
          "score": 0,
          "accessCount": 0,
          "queryHitCount": 0,
          "lastAccessedAt": "",
          "createdAt": "",
          "updatedAt": "",
          "sourceVaultFileId": "",
          "reviewState": "auto",
          "provenance": {
            "createdBy": {
              "id": "",
              "operation": "create",
              "actor": "user",
              "source": "manual",
              "model": {
                "provider": "",
                "model": ""
              },
              "sourceReference": "",
              "createdAt": ""
            },
            "lastUpdatedBy": {
              "id": "",
              "operation": "create",
              "actor": "user",
              "source": "manual",
              "model": {
                "provider": "",
                "model": ""
              },
              "sourceReference": "",
              "createdAt": ""
            },
            "contributors": [
              {
                "provider": "",
                "model": ""
              }
            ]
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Resource not found.

  request: {
    url: {{baseUrl}}/v1/memory/:id
    method: GET
    mode: none
    params:path: {
      id:
    }
  }

  response: {
