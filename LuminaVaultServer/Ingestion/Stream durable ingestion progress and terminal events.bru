}

params:query {
  ~after: 0
}

params:path {
  batchID:
}

headers {
  ~Last-Event-ID: 0
}

example {
  name: 200 Response
  description: Server-sent event stream; each ingestion event is durable and resumable by ID.

  request: {
    url: {{baseUrl}}/v1/ingestions/:batchID/events
    method: GET
    mode: none
    params:query: {
      ~after: 0
    }

    params:path: {
      batchID:
    }

    headers: {
      ~Last-Event-ID: 0
    }
  }

  response: {
    headers: {
      Content-Type: text/event-stream
    }

    status: {
      code: 200
