  ]
}

head {
  url: {{baseUrl}}/v1/ingestion-sources/:token
  body: none
  auth: inherit
}

params:path {
  token:
}

example {
  name: 200 Response
  description: Source metadata headers.

  request: {
    url: {{baseUrl}}/v1/ingestion-sources/:token
    method: HEAD
    mode: none
