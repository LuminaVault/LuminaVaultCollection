meta {
  name: Upload one idempotent chunk (maximum 8 MiB)
  type: http
  seq: 7
  tags: [
    Ingestion
  ]
}

put {
  url: {{baseUrl}}/v1/ingestions/:batchID/items/:itemID/chunks/:index
  body: text
  auth: inherit
}

params:path {
  batchID:
  itemID:
  index: 0
}

example {
  name: 204 Response
  description: Chunk accepted.

  request: {
    url: {{baseUrl}}/v1/ingestions/:batchID/items/:itemID/chunks/:index
    method: PUT
    mode: text
    params:path: {
      batchID:
      itemID:
      index: 0
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: insufficientStorage

  request: {
    url: {{baseUrl}}/v1/ingestions/:batchID/items/:itemID/chunks/:index
    method: PUT
    mode: text
    params:path: {
      batchID:
      itemID:
      index: 0
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 507
      text: Insufficient Storage
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "insufficient_storage",
            "message": "LuminaVault is short on storage space right now, so this wasn't saved. Please try again later."
          }
        }
      '''
    }
  }
}
