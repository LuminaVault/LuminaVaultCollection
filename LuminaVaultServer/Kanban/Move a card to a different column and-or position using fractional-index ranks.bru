meta {
  name: Move a card to a different column and/or position using fractional-index ranks
  type: http
  seq: 14
  tags: [
    Kanban
  ]
}

post {
  url: {{baseUrl}}/v1/cards/:cardID/move
  body: json
  auth: inherit
}

params:path {
  cardID:
}

body:json {
  {
    "toColumnID": "",
    "beforeID": "",
    "afterID": ""
  }
}

example {
  name: 200 Response
  description: Updated card snapshot at its new position.

  request: {
    url: {{baseUrl}}/v1/cards/:cardID/move
    method: POST
    mode: json
    params:path: {
      cardID:
    }

    body:json: {
      {
        "toColumnID": "",
        "beforeID": "",
        "afterID": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "columnID": "",
          "title": "",
          "body": "",
          "priority": "",
          "dueAt": "",
          "rank": "",
          "updatedAt": ""
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing / invalid credential.

  request: {
    url: {{baseUrl}}/v1/cards/:cardID/move
    method: POST
    mode: json
    params:path: {
      cardID:
    }

    body:json: {
      {
        "toColumnID": "",
        "beforeID": "",
        "afterID": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Resource not found.

  request: {
    url: {{baseUrl}}/v1/cards/:cardID/move
    method: POST
    mode: json
    params:path: {
      cardID:
    }

    body:json: {
      {
        "toColumnID": "",
        "beforeID": "",
        "afterID": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
