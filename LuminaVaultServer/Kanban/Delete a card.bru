meta {
  name: Delete a card
  type: http
  seq: 13
  tags: [
    Kanban
  ]
}

delete {
  url: {{baseUrl}}/v1/cards/:cardID
  body: none
  auth: inherit
}

params:path {
  cardID:
}

example {
  name: 204 Response
  description: Card deleted.

  request: {
    url: {{baseUrl}}/v1/cards/:cardID
    method: DELETE
    mode: none
    params:path: {
      cardID:
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing / invalid credential.

  request: {
    url: {{baseUrl}}/v1/cards/:cardID
    method: DELETE
    mode: none
    params:path: {
      cardID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Resource not found.

  request: {
    url: {{baseUrl}}/v1/cards/:cardID
    method: DELETE
    mode: none
    params:path: {
      cardID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
