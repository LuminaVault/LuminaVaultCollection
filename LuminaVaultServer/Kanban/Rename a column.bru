meta {
  name: Rename a column
  type: http
  seq: 8
  tags: [
    Kanban
  ]
}

patch {
  url: {{baseUrl}}/v1/boards/:boardID/columns/:columnID
  body: json
  auth: inherit
}

params:path {
  boardID:
  columnID:
}

body:json {
  {
    "title": ""
  }
}

example {
  name: 200 Response
  description: Updated board snapshot.

  request: {
    url: {{baseUrl}}/v1/boards/:boardID/columns/:columnID
    method: PATCH
    mode: json
    params:path: {
      boardID:
      columnID:
    }

    body:json: {
      {
        "title": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "title": "",
          "version": 0,
          "columns": [
            {
              "id": "",
              "title": "",
              "rank": "",
              "cards": [
                {
                  "id": "",
                  "columnID": "",
                  "title": "",
                  "body": "",
                  "priority": "",
                  "dueAt": "",
                  "rank": "",
                  "updatedAt": ""
                }
              ]
            }
          ]
        }
      '''
    }
  }
}

