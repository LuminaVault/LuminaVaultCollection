meta {
  name: List all boards for the authenticated tenant
  type: http
  seq: 1
  tags: [
    Kanban
  ]
}

get {
  url: {{baseUrl}}/v1/boards
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: Array of board summaries.

  request: {
    url: {{baseUrl}}/v1/boards
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        [
          {
            "id": "",
            "title": "",
            "version": 0,
            "columnCount": 0,
            "cardCount": 0,
            "updatedAt": ""
          }
        ]
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing / invalid credential.

  request: {
    url: {{baseUrl}}/v1/boards
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
