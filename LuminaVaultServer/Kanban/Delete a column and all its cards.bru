meta {
  name: Delete a column and all its cards
  type: http
  seq: 9
  tags: [
    Kanban
  ]
}

delete {
  url: {{baseUrl}}/v1/boards/:boardID/columns/:columnID
  body: none
  auth: inherit
}

params:path {
  boardID:
  columnID:
}

example {
  name: 200 Response
  description: Updated board snapshot (column removed).

  request: {
    url: {{baseUrl}}/v1/boards/:boardID/columns/:columnID
    method: DELETE
    mode: none
    params:path: {
      boardID:
      columnID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "title": "",
          "version": 0,
          "columns": [
            {
              "id": "",
              "title": "",
              "rank": "",
              "cards": [
                {
                  "id": "",
                  "columnID": "",
                  "title": "",
                  "body": "",
                  "priority": "",
                  "dueAt": "",
                  "rank": "",
                  "updatedAt": ""
                }
              ]
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing / invalid credential.

  request: {
    url: {{baseUrl}}/v1/boards/:boardID/columns/:columnID
    method: DELETE
    mode: none
    params:path: {
      boardID:
      columnID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Resource not found.

  request: {
    url: {{baseUrl}}/v1/boards/:boardID/columns/:columnID
    method: DELETE
    mode: none
    params:path: {
      boardID:
      columnID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
