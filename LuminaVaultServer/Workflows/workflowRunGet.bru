        {
          "id": "",
          "workflowID": "",
          "workflowName": "",
          "version": 0,
          "status": "queued",
          "trigger": "manual",
          "startedAt": "",
          "endedAt": "",
          "createdAt": "",
          "error": "",
          "pauseReason": "runSpendLimit",
          "managedSpendUsdMicros": 0,
          "managedSpendLimitUsdMicros": 0,
          "nodeRuns": [
            {
              "id": "",
              "nodeID": "",
              "nodeName": "",
              "status": "pending",
              "attempt": 0,
              "startedAt": "",
              "endedAt": "",
              "outputPreview": "",
              "error": "",
              "provider": "",
              "model": "",
              "tokensIn": 0,
              "tokensOut": 0,
