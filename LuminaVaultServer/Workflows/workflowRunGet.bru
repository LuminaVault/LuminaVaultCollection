  ]
}

get {
  url: {{baseUrl}}/v1/workflows/runs/:runID
  body: none
  auth: inherit
}

params:path {
  runID:
}

example {
  name: 200 Response
  description: Run detail.

  request: {
    url: {{baseUrl}}/v1/workflows/runs/:runID
    method: GET
    mode: none
    params:path: {
      runID:
    }
  }

  response: {
