meta {
  name: workflowWebhookIngest
  type: http
  seq: 9
  tags: [
    Workflows
  ]
}

post {
  url: {{baseUrl}}/v1/workflow-hooks/:hookID
  body: json
  auth: inherit
}

params:path {
  hookID:
}

headers {
  X-Lumina-Timestamp:
  X-Lumina-Signature:
  Idempotency-Key:
}

body:json {
  {}
}

example {
  name: 200 Response
  description: Queued or previously queued run.

  request: {
    url: {{baseUrl}}/v1/workflow-hooks/:hookID
    method: POST
    mode: json
    params:path: {
      hookID:
    }

    headers: {
      X-Lumina-Timestamp:
      X-Lumina-Signature:
      Idempotency-Key:
    }

    body:json: {
      {}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "workflowID": "",
          "workflowName": "",
          "version": 0,
          "status": "queued",
          "trigger": "manual",
          "startedAt": "",
          "endedAt": "",
          "createdAt": "",
          "error": "",
          "pauseReason": "runSpendLimit",
          "managedSpendUsdMicros": 0,
          "managedSpendLimitUsdMicros": 0,
          "nodeRuns": [
            {
              "id": "",
              "nodeID": "",
              "nodeName": "",
              "status": "pending",
              "attempt": 0,
              "startedAt": "",
              "endedAt": "",
              "outputPreview": "",
              "error": "",
              "provider": "",
              "model": "",
              "tokensIn": 0,
              "tokensOut": 0,
              "managedCostUsdMicros": 0
            }
          ]
        }
      '''
    }
  }
}

