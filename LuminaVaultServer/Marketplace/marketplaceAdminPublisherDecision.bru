meta {
  name: marketplaceAdminPublisherDecision
  type: http
  seq: 18
  tags: [
    Marketplace
  ]
}

post {
  url: {{baseUrl}}/v1/marketplace/admin/publishers/:publisherID/decision
  body: json
  auth: inherit
}

params:path {
  publisherID:
}

body:json {
  {
    "approved": false,
    "note": ""
  }
}

example {
  name: 200 Response
  description: Reviewed publisher.

  request: {
    url: {{baseUrl}}/v1/marketplace/admin/publishers/:publisherID/decision
    method: POST
    mode: json
    params:path: {
      publisherID:
    }

    body:json: {
      {
        "approved": false,
        "note": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "handle": "",
          "displayName": "",
          "bio": "",
          "websiteURL": "",
          "verified": false,
          "status": "pending"
        }
      '''
    }
  }
}
