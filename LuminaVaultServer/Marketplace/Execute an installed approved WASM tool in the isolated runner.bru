meta {
  name: Execute an installed approved WASM tool in the isolated runner
  type: http
  seq: 7
  tags: [
    Marketplace
  ]
}

post {
  url: {{baseUrl}}/v1/marketplace/plugins/:slug/tools/:toolName/run
  body: json
  auth: inherit
}

params:path {
  slug:
  toolName:
}

body:json {
  {
    "input": {}
  }
}

example {
  name: 200 Response
  description: Sandboxed tool output.

  request: {
