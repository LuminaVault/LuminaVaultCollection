meta {
  name: Install an approved immutable version with explicit permission grants
  type: http
  seq: 5
  tags: [
    Marketplace
  ]
}

post {
  url: {{baseUrl}}/v1/marketplace/plugins/:slug/install
  body: json
  auth: inherit
}

params:path {
  slug:
}

body:json {
  {
    "versionId": "",
    "grantedPermissions": [
      "memory.read"
    ],
    "config": {}
  }
}

example {
  name: 200 Response
  description: Installed.

  request: {
    url: {{baseUrl}}/v1/marketplace/plugins/:slug/install
    method: POST
    mode: json
    params:path: {
      slug:
    }

    body:json: {
      {
        "versionId": "",
        "grantedPermissions": [
          "memory.read"
        ],
        "config": {}
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "pluginSlug": "",
          "status": "enabled",
          "hasConfig": false,
          "createdAt": "",
          "lastSyncAt": "",
          "marketplaceVersionId": "",
          "grantedPermissions": [
            "memory.read"
          ]
        }
      '''
    }
  }
}
