meta {
  name: Create a new chat conversation (HER-37)
  type: http
  seq: 2
  tags: [
    Conversations
  ]
}

post {
  url: {{baseUrl}}/v1/conversations
  body: json
  auth: inherit
}

body:json {
  {
    "title": "",
    "spaceId": "",
    "pinnedMemoryIDs": [],
    "routeOverride": {
      "provider": "xai",
      "model": "",
      "inputPerMillionUsdMicros": 0,
      "outputPerMillionUsdMicros": 0
    }
  }
}

example {
  name: 200 Response
  description: Created conversation.

  request: {
    url: {{baseUrl}}/v1/conversations
    method: POST
    mode: json
    body:json: {
      {
        "title": "",
        "spaceId": "",
        "pinnedMemoryIDs": [],
        "routeOverride": {
          "provider": "xai",
          "model": "",
          "inputPerMillionUsdMicros": 0,
          "outputPerMillionUsdMicros": 0
        }
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "title": "",
          "spaceId": "",
          "createdAt": "",
          "updatedAt": "",
          "pinnedMemoryIDs": [],
          "routeOverride": {
            "provider": "xai",
            "model": "",
            "inputPerMillionUsdMicros": 0,
            "outputPerMillionUsdMicros": 0
          }
        }
      '''
    }
  }
}
