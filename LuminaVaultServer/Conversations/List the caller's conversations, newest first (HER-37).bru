meta {
  name: List the caller's conversations, newest first (HER-37)
  type: http
  seq: 3
  tags: [
    Conversations
  ]
}

get {
  url: {{baseUrl}}/v1/conversations
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: Conversation list.

  request: {
    url: {{baseUrl}}/v1/conversations
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "conversations": [
            {
              "id": "",
              "title": "",
              "spaceId": "",
              "createdAt": "",
              "updatedAt": "",
              "pinnedMemoryIDs": [],
              "routeOverride": {
                "provider": "xai",
                "model": "",
                "inputPerMillionUsdMicros": 0,
                "outputPerMillionUsdMicros": 0
              }
            }
          ],
          "nextCursor": ""
        }
      '''
    }
  }
}
