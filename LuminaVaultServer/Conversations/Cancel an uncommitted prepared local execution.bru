meta {
  name: Cancel an uncommitted prepared local execution
  type: http
  seq: 10
  tags: [
    Conversations
  ]
}

delete {
  url: {{baseUrl}}/v1/conversations/:id/local-executions/:executionID
  body: none
  auth: inherit
}

params:path {
  id:
  executionID:
}

example {
  name: 204 Response
  description: Cancelled.

  request: {
    url: {{baseUrl}}/v1/conversations/:id/local-executions/:executionID
    method: DELETE
    mode: none
    params:path: {
      id:
      executionID:
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 409 Response
  description: Execution was already committed.

  request: {
    url: {{baseUrl}}/v1/conversations/:id/local-executions/:executionID
    method: DELETE
    mode: none
    params:path: {
      id:
      executionID:
    }
  }

  response: {
    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
