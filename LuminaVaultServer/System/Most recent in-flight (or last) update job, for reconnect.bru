meta {
  name: Most recent in-flight (or last) update job, for reconnect
  type: http
  seq: 3
  tags: [
    System
  ]
}

get {
  url: {{baseUrl}}/v1/system/hermes/update/current
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

example {
  name: 200 Response
  description: Job snapshot.

  request: {
    url: {{baseUrl}}/v1/system/hermes/update/current
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "status": {
            "jobID": "",
            "state": "running",
            "steps": [
              {
                "id": "preflight",
                "state": "pending",
                "detail": "",
                "startedAt": "",
                "finishedAt": ""
              }
            ],
            "fromVersion": "",
            "toVersion": "",
            "errorMessage": "",
            "startedAt": "",
            "updatedAt": ""
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Resource not found.

  request: {
    url: {{baseUrl}}/v1/system/hermes/update/current
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
