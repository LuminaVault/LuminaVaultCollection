meta {
  name: Manually roll a failed update back to its previous version
  type: http
  seq: 6
  tags: [
    System
  ]
}

post {
  url: {{baseUrl}}/v1/system/hermes/update/:jobID/rollback
  body: none
  auth: bearer
}

params:path {
  jobID:
}

auth:bearer {
  token: {{token}}
}

example {
  name: 200 Response
  description: Rollback job accepted.

  request: {
    url: {{baseUrl}}/v1/system/hermes/update/:jobID/rollback
    method: POST
    mode: none
    params:path: {
      jobID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "jobID": "",
          "state": "running"
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Rollback unavailable (no recorded previous version).

  request: {
    url: {{baseUrl}}/v1/system/hermes/update/:jobID/rollback
    method: POST
    mode: none
    params:path: {
      jobID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: An update is already in progress.

  request: {
    url: {{baseUrl}}/v1/system/hermes/update/:jobID/rollback
    method: POST
    mode: none
    params:path: {
      jobID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
