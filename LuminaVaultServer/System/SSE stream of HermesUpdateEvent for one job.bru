meta {
  name: SSE stream of HermesUpdateEvent for one job
  type: http
  seq: 5
  tags: [
    System
  ]
}

get {
  url: {{baseUrl}}/v1/system/hermes/update/:jobID/stream
  body: none
  auth: bearer
}

params:path {
  jobID:
}

auth:bearer {
  token: {{token}}
}

docs {
  `text/event-stream`; each `data:` line is one JSON-encoded `HermesUpdateEvent` (discriminated by `type`), blank-line terminated.

}

example {
  name: 200 Response
  description: Event stream.

  request: {
    url: {{baseUrl}}/v1/system/hermes/update/:jobID/stream
    method: GET
    mode: none
    params:path: {
      jobID:
    }
  }

  response: {
    headers: {
      Content-Type: text/event-stream
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 404 Response
  description: Resource not found.

  request: {
    url: {{baseUrl}}/v1/system/hermes/update/:jobID/stream
    method: GET
    mode: none
    params:path: {
      jobID:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": "",
          "message": ""
        }
      '''
    }
  }
}
