meta {
  name: Install a plugin with its config (re-installing replaces config)
  type: http
  seq: 6
  tags: [
    Plugins
  ]
}

post {
  url: {{baseUrl}}/v1/plugins/installs
  body: json
  auth: inherit
}

body:json {
  {
    "pluginSlug": "",
    "config": {}
  }
}

docs {
  Validates `config` against the catalog entry's fields; secret values are
  sealed at rest and never echoed (responses carry `hasConfig` only).
  Premium plugins require the pro/ultimate tier → 402 otherwise.

}

example {
  name: 200 Response
  description: Install created or updated.

  request: {
    url: {{baseUrl}}/v1/plugins/installs
    method: POST
    mode: json
    body:json: {
      {
        "pluginSlug": "",
        "config": {}
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "pluginSlug": "",
          "status": "enabled",
          "hasConfig": false,
          "createdAt": "",
          "lastSyncAt": "",
          "marketplaceVersionId": "",
          "grantedPermissions": [
            "memory.read"
          ]
        }
      '''
    }
  }
}

example {
  name: 402 Response
  description: Premium plugin requires a paid subscription (premium_required).

  request: {
    url: {{baseUrl}}/v1/plugins/installs
    method: POST
    mode: json
    body:json: {
      {
        "pluginSlug": "",
        "config": {}
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 402
      text: Payment Required
    }

    body: {
      type: json
      content: '''
        {
          "paywall": false,
          "paywallId": "default",
          "requiredTier": "pro"
        }
      '''
    }
  }
}
