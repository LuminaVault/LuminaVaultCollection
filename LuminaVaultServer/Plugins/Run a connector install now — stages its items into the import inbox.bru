meta {
  name: Run a connector install now — stages its items into the import inbox
  type: http
  seq: 9
  tags: [
    Plugins
  ]
}

post {
  url: {{baseUrl}}/v1/plugins/installs/:id/sync
  body: none
  auth: inherit
}

params:path {
  id:
}

docs {
  Connector capability only. Returns a standard import session id; follow
  with POST /v1/import/{id}/categorize then /approve to file + compile.

}

example {
  name: 200 Response
  description: Sync staged items into a new import session.

  request: {
    url: {{baseUrl}}/v1/plugins/installs/:id/sync
    method: POST
    mode: none
    params:path: {
      id:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "installId": "",
          "sessionId": "",
          "status": "",
          "total": 0,
          "staged": 0,
          "skipped": 0
        }
      '''
    }
  }
}
