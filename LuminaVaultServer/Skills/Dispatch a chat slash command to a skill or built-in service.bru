meta {
  name: Dispatch a chat slash command to a skill or built-in service
  type: http
  seq: 7
  tags: [
    Skills
  ]
}

post {
  url: {{baseUrl}}/v1/skills/slash
  body: json
  auth: inherit
}

body:json {
  {
    "command": ""
  }
}

example {
  name: 200 Response
  description: Slash command completed.

  request: {
    url: {{baseUrl}}/v1/skills/slash
    method: POST
    mode: json
    body:json: {
      {
        "command": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "",
          "skillName": "",
          "status": "pending",
          "markdown": "",
          "savedPath": "",
          "modelUsed": "",
          "mtokIn": "",
          "mtokOut": "",
          "startedAt": "",
          "endedAt": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Not a slash command.

  request: {
    url: {{baseUrl}}/v1/skills/slash
    method: POST
    mode: json
    body:json: {
      {
        "command": ""
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 402 Response
  description: Tier entitlement or daily-cap exhaustion.

  request: {
    url: {{baseUrl}}/v1/skills/slash
    method: POST
    mode: json
    body:json: {
      {
        "command": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 402
      text: Payment Required
    }

    body: {
      type: json
      content: '''
        {
          "paywall": false,
          "paywallId": "default",
          "requiredTier": "pro"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Unknown skill.

  request: {
    url: {{baseUrl}}/v1/skills/slash
    method: POST
    mode: json
    body:json: {
      {
        "command": ""
      }
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}
