meta {
  name: Reject a pending SOUL.md proposal
  type: http
  seq: 12
  tags: [
    Self_Improvement
  ]
}

post {
  url: {{baseUrl}}/v1/me/improvement/changes/:id/reject
  body: none
  auth: inherit
}

params:path {
  id:
}

example {
  name: 200 Response
  description: Rejected proposal.

  request: {
    url: {{baseUrl}}/v1/me/improvement/changes/:id/reject
    method: POST
    mode: none
    params:path: {
      id:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "change": {
            "id": "",
            "kind": "curator",
            "state": "pending",
            "trigger": "manual",
            "title": "",
            "summary": "",
            "patch": "",
            "baseSHA256": "",
            "reportMarkdown": "",
            "failureReason": "",
            "createdAt": "",
            "decidedAt": "",
            "appliedAt": ""
          }
        }
      '''
    }
  }
}
