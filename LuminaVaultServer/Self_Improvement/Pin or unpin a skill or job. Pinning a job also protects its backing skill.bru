meta {
  name: Pin or unpin a skill or job. Pinning a job also protects its backing skill
  type: http
  seq: 8
  tags: [
    Self_Improvement
  ]
}

patch {
  url: {{baseUrl}}/v1/me/improvement/resources/:kind/:name
  body: json
  auth: inherit
}

params:path {
  kind: skill
  kind: job
  name:
}

body:json {
  {
    "pinned": false
  }
}

example {
  name: 200 Response
  description: Updated resource.

  request: {
    url: {{baseUrl}}/v1/me/improvement/resources/:kind/:name
    method: PATCH
    mode: json
    params:path: {
      kind: skill
      ~kind: job
      name:
    }

    body:json: {
      {
        "pinned": false
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "name": "",
          "title": "",
          "kind": "skill",
          "state": "active",
          "pinned": false,
          "curatorManaged": false,
          "lastActivityAt": ""
        }
      '''
    }
  }
}
