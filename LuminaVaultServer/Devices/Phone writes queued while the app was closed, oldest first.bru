meta {
  name: Phone writes queued while the app was closed, oldest first
  type: http
  seq: 3
  tags: [
    Devices
  ]
}

get {
  url: {{baseUrl}}/v1/devices/commands/pending
  body: none
  auth: inherit
}

docs {
  A `reminder_create` or `calendar_create` that could not reach the
  phone live is queued for 24 hours and announced with a push. The app
  reads this on open, runs each command once, and posts each result to
  `/v1/devices/command/{id}/result`, which removes it from this list.

}

example {
  name: 200 Response
  description: Pending commands.

  request: {
    url: {{baseUrl}}/v1/devices/commands/pending
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "commands": [
            {
              "id": "",
              "kind": "ping",
              "domain": "health",
              "payload": {}
            }
          ]
        }
      '''
    }
  }
}
