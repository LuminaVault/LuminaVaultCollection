meta {
  name: Gmail read access state
  type: http
  seq: 4
  tags: [
    Calendar
  ]
}

get {
  url: {{baseUrl}}/v1/mail/gmail/status
  body: none
  auth: inherit
}

docs {
  Gmail is an incremental `gmail.readonly` scope on the Google Calendar
  OAuth client and grant — one Google account per tenant.

}

example {
  name: 200 Response
  description: Gmail status.

  request: {
    url: {{baseUrl}}/v1/mail/gmail/status
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "connected": false,
          "needsReauth": false,
          "accountEmail": "",
          "calendarConnected": false
        }
      '''
    }
  }
}
